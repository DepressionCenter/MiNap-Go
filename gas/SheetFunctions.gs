/** Fallback study ID for a new row that has no study ID of its own to inherit from the row
 *  above it, and none was passed in. A real study should set its own study_id on the first
 *  row of ParticipantsSetup; this only covers a workbook nobody has touched yet. */
const DEFAULT_STUDY_NAME = 'SLEEP';

/** Letters used in a generated Participant ID. Chosen to avoid characters easy to misread on
 *  paper or a screen: I/1/L, O/0, and letters that look alike in some fonts (B/8, S/5, Z/2,
 *  G/6, Q/0). A participant who has to type this ID back in at every login should not have to
 *  guess which character it was. */
const PARTICIPANT_ID_LETTERS = ['A', 'F', 'H', 'J', 'K', 'P', 'T', 'V', 'X', 'Y'];

/**
 * Client-facing: writes a random, unique Participant ID into the next open row of
 * ParticipantsSetup, and sets that row's enabled column to Yes.
 *
 * Assigned to the "Generate Participant ID" image on ParticipantsSetup (see
 * ensureParticipantIdGeneratorButton_), so it has to keep the public name Apps Script's image
 * "Assign script" picker can discover -- the same discovery google.script.run uses from the
 * deployed web app page (architecture.md §7). To keep it from being reachable that way, the
 * first thing it does is check for a bound spreadsheet UI, which is only present when a
 * signed-in editor triggered it from inside the Sheet itself.
 *
 * @param {string} sheetName Worksheet to write into. Defaults to ParticipantsSetup.
 * @param {string} defaultStudyName Study ID to use for a row with none to inherit.
 * @param {number} numberOfDigits How many digits follow the letter prefix.
 */
function generateRandomParticipantId(
  sheetName = 'ParticipantsSetup',
  defaultStudyName = DEFAULT_STUDY_NAME,
  numberOfDigits = 3
) {
  try {
    SpreadsheetApp.getUi();
  } catch (err) {
    // No bound spreadsheet UI behind this call, which is what google.script.run from the
    // standalone web app page looks like. Refuse rather than let a page visitor add
    // themselves to the roster with enabled set to Yes.
    return;
  }

  const ss = getSpreadsheet_();
  const sh = ss.getSheetByName(sheetName);
  if (!sh) {
    SpreadsheetApp.getUi().alert('Sheet "' + sheetName + '" not found.');
    return;
  }

  // Column positions come from the live header row, not fixed letters, so this keeps working
  // if a researcher reorders ParticipantsSetup's columns -- the same reason every other write
  // path in Code.gs resolves columns through sheetHeaderMap_/columnOf_ instead of a position.
  let studyIdColIndex, participantIdColIndex, activeColIndex;
  try {
    const headerMap = sheetHeaderMap_(sh);
    studyIdColIndex = columnOf_(headerMap, 'study_id', sheetName);
    participantIdColIndex = columnOf_(headerMap, 'participant_id', sheetName);
    activeColIndex = columnOf_(headerMap, 'enabled', sheetName);
  } catch (err) {
    SpreadsheetApp.getUi().alert(err.message);
    return;
  }

  // Get data up to the last row + 1
  const lastRow = sh.getLastRow();
  const maxRows = Math.max(lastRow + 1, 2);
  const data = sh.getRange(1, 1, maxRows, sh.getLastColumn()).getValues();

  // Collect all existing participant IDs for uniqueness checking
  const existingIds = new Set();
  for (let i = 1; i < data.length; i++) {
    let valParticipantId = String(data[i][participantIdColIndex - 1]).trim();
    if (valParticipantId !== "") {
      existingIds.add(valParticipantId);
    }
  }

  let targetRowIndex = -1;
  let studyIdToSet = null;

  // Loop through data starting from row 2 (index 1), assuming row 1 is the header
  for (let i = 1; i < data.length; i++) {
    let valStudyId = String(data[i][studyIdColIndex - 1]).trim();
    let valParticipantId = String(data[i][participantIdColIndex - 1]).trim();

    // Condition: (StudyId and ParticipantId are empty) OR (StudyId is longer than 1 character and ParticipantId is empty)
    if ((valStudyId === "" && valParticipantId === "") || (valStudyId.length > 1 && valParticipantId === "")) {
      targetRowIndex = i;

      if (valStudyId === "") {
        // If StudyId is empty, use previous row's StudyId or fallback to default
        if (i === 1) {
          studyIdToSet = defaultStudyName;
        } else {
          let prevStudyId = String(data[i - 1][studyIdColIndex - 1]).trim();
          studyIdToSet = prevStudyId !== "" ? prevStudyId : defaultStudyName;
        }
      }
      break;
    }
  }

  // Generate a unique random participant ID
  let participantID;
  let attempts = 0;
  const maxAttempts = 1000;

  do {
    const letterPrefix = PARTICIPANT_ID_LETTERS[Math.floor(Math.random() * PARTICIPANT_ID_LETTERS.length)];
    const maxNumber = Math.pow(20, numberOfDigits) - 1;
    const randomNum = Math.floor(Math.random() * (maxNumber + 1));
    const paddedNum = String(randomNum).padStart(numberOfDigits, '0');
    participantID = letterPrefix + paddedNum;
    attempts++;
  } while (existingIds.has(participantID) && attempts < maxAttempts);

  if (attempts >= maxAttempts) {
    SpreadsheetApp.getUi().alert("Unable to generate a unique participant ID. ID space may be exhausted.");
    return;
  }

  // Convert 0-indexed array to 1-indexed sheet row
  const targetRowNum = targetRowIndex + 1;
  
  // Set the study ID if it's empty
  if (studyIdToSet !== null) {
    sh.getRange(targetRowNum, studyIdColIndex).setValue(studyIdToSet);
  }
  
  // Set the participant ID
  sh.getRange(targetRowNum, participantIdColIndex).setValue(participantID);

  sh.getRange(targetRowNum, activeColIndex).setValue(BOOL_YES);

  SpreadsheetApp.flush();
}

/**
 * Creates the "Generate Participant ID" button on ParticipantsSetup if it is not there yet,
 * and leaves the sheet untouched otherwise. Provisioning-only: never called from a browser,
 * which is what the trailing underscore signals.
 *
 * @param {Sheet} sh The ParticipantsSetup worksheet.
 */
function ensureParticipantIdGeneratorButton_(sh) {
  const imageTitle = "Generate Participant ID";

  // Provisioning never repeats work: if the button is already there, leave it alone.
  const alreadyThere = sh.getImages().some(image => image.getAltTextTitle() === imageTitle);
  if (alreadyThere) return;

  const dataUrl = "data:image/png;base64,";
  
  const base64Data = dataUrl.split(',')[1];
  const decodedData = Utilities.base64Decode(base64Data);
  const imageBlob = Utilities.newBlob(decodedData, 'image/png', 'generate-participant-id-button');
  const insertedImage = sh.insertImage(imageBlob, 2, 1, 94, 1);
  insertedImage.setAltTextTitle(imageTitle);
  insertedImage.setWidth(28).setHeight(28);
  insertedImage.assignScript("generateRandomParticipantId");
}

